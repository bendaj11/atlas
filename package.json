{
  "name": "atlas-platform",
  "version": "0.3.37",
  "private": true,
  "description": "TypeScript-first app platform with focused SDK, runtime, static registry, generators and test tooling.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bendaj11/atlas.git"
  },
  "homepage": "https://github.com/bendaj11/atlas#readme",
  "bugs": "https://github.com/bendaj11/atlas/issues",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build --filter=\"@atlas/*\"",
    "build:examples": "turbo run build --concurrency=1 --filter=\"@atlas-example/*\" --filter=\"@atlas-app/*\"",
    "ci:affected": "pnpm run typecheck:affected && pnpm run test:affected",
    "ci:full": "pnpm run typecheck && pnpm run test",
    "pack:verify": "node scripts/verify-packages.js",
    "release": "node scripts/release.js",
    "release:publish": "node scripts/publish-release.js",
    "test:generated": "pnpm run pack:verify && node scripts/verify-generated-projects.js --package-manager=yarn && node scripts/verify-generated-projects.js --package-manager=pnpm",
    "test": "turbo run test --filter=\"@atlas/*\" && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.json --roots scripts",
    "test:affected": "turbo run test --affected --filter=\"@atlas/*\"",
    "test:e2e": "node tests/e2e/prepare.js && playwright test",
    "test:container": "pnpm run pack:verify && node scripts/verify-bootstrap-container.js",
    "test:e2e:prepare": "node tests/e2e/prepare.js",
    "typecheck": "turbo run typecheck --filter=\"@atlas/*\" && tsc -p tsconfig.tests.json",
    "typecheck:affected": "turbo run typecheck --affected --filter=\"@atlas/*\"",
    "atlas": "node packages/cli/dist/cli/entrypoint.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@jest/globals": "29.7.0",
    "@types/jest": "29.5.14",
    "@types/node": "^22",
    "cross-spawn": "7.0.6",
    "jest": "29.7.0",
    "prettier": "3.9.5",
    "tar": "7.5.21",
    "ts-jest": "29.2.5",
    "turbo": "^2.6.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10 <11"
  }
}
