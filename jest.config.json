{
  "extensionsToTreatAsEsm": [
    ".ts",
    ".tsx"
  ],
  "moduleNameMapper": {
    "^@atlas/testkit$": "<rootDir>/packages/testkit/src/index.ts",
    "^@atlas/testkit/internal$": "<rootDir>/packages/testkit/src/internal.ts",
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^(\\.{1,2}/.*)\\.cjs$": [
      "$1.cts",
      "$1.cjs"
    ],
    "^rxjs$": "<rootDir>/node_modules/.pnpm/node_modules/rxjs/dist/cjs/index.js",
    "^rxjs/operators$": "<rootDir>/node_modules/.pnpm/node_modules/rxjs/dist/cjs/operators/index.js"
  },
  "modulePathIgnorePatterns": [
    "<rootDir>/dist/",
    "<rootDir>/.claude/worktrees/"
  ],
  "rootDir": ".",
  "testPathIgnorePatterns": [
    "<rootDir>/examples/e2e/",
    "<rootDir>/.claude/worktrees/"
  ],
  "testEnvironment": "node",
  "testMatch": [
    "**/*.specs.ts",
    "**/*.specs.tsx"
  ],
  "transform": {
    "^.+\\.[cm]?tsx?$": [
      "ts-jest",
      {
        "diagnostics": true,
        "tsconfig": "<rootDir>/tsconfig.tests.json",
        "useESM": true
      }
    ]
  },
  "maxWorkers": "50%",
  "workerIdleMemoryLimit": "512MB"
}
