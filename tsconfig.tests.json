{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@atlas/testkit": ["./packages/testkit/src/index.ts"],
      "@atlas/testkit/internal": ["./packages/testkit/src/internal.ts"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["jest", "node"],
    "experimentalDecorators": true
  },
  "include": [
    "apps/**/*.specs.ts",
    "apps/**/*.specs.tsx",
    "apps/**/*.driver.ts",
    "apps/**/*.driver.tsx",
    "packages/**/*.specs.ts",
    "packages/**/*.specs.tsx",
    "packages/**/*.driver.ts",
    "packages/**/*.driver.tsx",
    "packages/runtime/src/css-tree.d.ts",
    "scripts/**/*.specs.ts",
    "scripts/**/*.driver.ts",
    "examples/e2e/*.specs.ts",
    "examples/e2e/*.driver.ts",
    "examples/e2e/playwright.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
