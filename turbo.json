{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NG_BUILD_MAX_WORKERS"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!dist/**", "!*.tsbuildinfo"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!dist/**", "!*.tsbuildinfo"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "env": ["CODEX_SANDBOX_NETWORK_DISABLED"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "atlas:config": {
      "outputs": [".atlas/**"]
    },
    "atlas:publish": {
      "cache": false,
      "dependsOn": ["atlas:config"],
      "env": ["ATLAS_*", "AWS_*", "CI_*", "GITHUB_*", "BITBUCKET_*", "VERCEL_*"]
    },
    "atlas:bootstrap": {
      "dependsOn": ["atlas:config"],
      "outputs": ["dist/bootstrap/**"]
    },
    "framework:dev": {
      "cache": false,
      "persistent": true
    }
  }
}
