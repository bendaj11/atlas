  "compilerOptions": {
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "examples/e2e/atlas.registry.ts",
    "examples/e2e/directory-publication-storage.ts",
    "examples/e2e/prepare.ts",
    "examples/e2e/static-server.ts"
  ]
}
