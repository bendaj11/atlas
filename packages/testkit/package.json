{
  "name": "@atlas/testkit",
  "version": "0.5.7",
  "type": "module",
  "description": "Test fixtures and in-memory utilities for Atlas hosts and apps.",
  "license": "MIT",
  "keywords": [
    "app",
    "testing",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bendaj11/atlas.git",
    "directory": "packages/testkit"
  },
  "homepage": "https://github.com/bendaj11/atlas/tree/main/packages/testkit#readme",
  "bugs": "https://github.com/bendaj11/atlas/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "default": "./dist/angular.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsx ../../scripts/clean-package-output.ts && tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.json --testPathPattern='packages/testkit/src/'"
  },
  "dependencies": {
    "@atlas/schema": "workspace:^",
    "@atlas/sdk": "workspace:^",
    "@faker-js/faker": "^10.5.0"
  },
  "peerDependencies": {
    "@angular/common": ">=19 <23",
    "@angular/core": ">=19 <23",
    "react": ">=17 <20"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "jest-environment-jsdom": "29.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
