{
  "name": "@atlas/generators",
  "version": "0.4.6",
  "type": "module",
  "description": "Project generators used internally by the Atlas CLI.",
  "license": "MIT",
  "keywords": [
    "app",
    "generator",
    "native-federation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bendaj11/atlas.git",
    "directory": "packages/generators"
  },
  "homepage": "https://github.com/bendaj11/atlas/tree/main/packages/generators#readme",
  "bugs": "https://github.com/bendaj11/atlas/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "tsx ../../scripts/clean-package-output.ts && tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@atlas/bootstrap": "0.4.6",
    "@atlas/schema": "0.4.6"
  }
}
