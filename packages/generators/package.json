{
  "name": "@atlas/generators",
  "version": "0.5.2",
  "type": "module",
  "description": "Project generators used internally by the Atlas CLI.",
  "license": "MIT",
  "keywords": [
    "app",
    "generator",
    "native-federation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bendaj11/atlas.git",
    "directory": "packages/generators"
  },
  "homepage": "https://github.com/bendaj11/atlas/tree/main/packages/generators#readme",
  "bugs": "https://github.com/bendaj11/atlas/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsx ../../scripts/clean-package-output.ts && tsc -b && esbuild src/index.ts --bundle --format=esm --platform=node --target=es2022 --packages=external --external:@atlas/* --minify --keep-names --sourcemap=external --outfile=dist/index.js --allow-overwrite",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.json --testPathPattern='packages/generators/src/'",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@atlas/bootstrap": "workspace:^",
    "@atlas/schema": "workspace:^"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "esbuild": "0.25.12"
  }
}
