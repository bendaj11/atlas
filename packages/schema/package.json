{
  "name": "@atlas/schema",
  "version": "0.3.27",
  "type": "module",
  "description": "Stable Atlas manifests, static indexes, catalogs, and configuration schemas.",
  "license": "MIT",
  "keywords": [
    "app",
    "typescript",
    "schema"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bendaj11/atlas.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/bendaj11/atlas/tree/main/packages/schema#readme",
  "bugs": "https://github.com/bendaj11/atlas/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-output.js && tsc -b",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.json --testPathPattern=packages/schema/tests/",
    "typecheck": "tsc -b --pretty false"
  }
}
