{
  "name": "@atlas/schema",
  "version": "0.5.1",
  "type": "module",
  "description": "Canonical Atlas manifests, registries, and runtime configuration schemas.",
  "license": "MIT",
  "keywords": [
    "app",
    "typescript",
    "schema"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bendaj11/atlas.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/bendaj11/atlas/tree/main/packages/schema#readme",
  "bugs": "https://github.com/bendaj11/atlas/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsx ../../scripts/clean-package-output.ts && tsc -b",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.json --testPathPattern='packages/schema/src/'",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0"
  }
}
