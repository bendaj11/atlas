{
  "name": "@atlas/runtime",
  "version": "0.3.53",
  "type": "module",
  "description": "Atlas host discovery, Native Federation loading, and mount lifecycle.",
  "license": "MIT",
  "keywords": [
    "app",
    "runtime",
    "native-federation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bendaj11/atlas.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/bendaj11/atlas/tree/main/packages/runtime#readme",
  "bugs": "https://github.com/bendaj11/atlas/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "default": "./dist/angular.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsx ../../scripts/clean-package-output.ts && ngc -p tsconfig.angular.json",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.json --testPathPattern=packages/runtime/tests/",
    "typecheck": "ngc -p tsconfig.angular.json --noEmit"
  },
  "dependencies": {
    "@atlas/schema": "0.3.53",
    "@atlas/sdk": "0.3.53"
  },
  "peerDependencies": {
    "@angular/core": ">=19 <23",
    "@angular/platform-browser": ">=19 <23",
    "react": ">=17 <21"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/platform-browser": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/compiler": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@types/react": "^19.2.0",
    "react": "^19.2.0"
  }
}
