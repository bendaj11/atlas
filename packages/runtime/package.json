{
  "name": "@atlas/runtime",
  "version": "0.5.3",
  "type": "module",
  "description": "Atlas host discovery, Native Federation loading, and mount lifecycle.",
  "license": "MIT",
  "keywords": [
    "app",
    "runtime",
    "native-federation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bendaj11/atlas.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/bendaj11/atlas/tree/main/packages/runtime#readme",
  "bugs": "https://github.com/bendaj11/atlas/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "default": "./dist/angular.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsx ../../scripts/clean-package-output.ts && ngc -p tsconfig.angular.json",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.mjs --coverage",
    "typecheck": "ngc -p tsconfig.angular.json --noEmit",
    "test:e2e": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.json --runInBand --testPathPattern='packages/runtime/e2e/' --testTimeout=30000"
  },
  "dependencies": {
    "@atlas/schema": "workspace:^",
    "@atlas/sdk": "workspace:^",
    "css-tree": "^3.2.1"
  },
  "peerDependencies": {
    "@angular/common": ">=19 <23",
    "@angular/core": ">=19 <23",
    "@angular/platform-browser": ">=19 <23",
    "@angular/router": ">=19 <23",
    "react": ">=17 <20",
    "react-dom": ">=17 <20",
    "react-router-dom": ">=6.4 <8"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/platform-browser": {
      "optional": true
    },
    "@angular/router": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@atlas/testkit": "workspace:*",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.0",
    "@types/css-tree": "^3.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.25.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  }
}
