{
  "name": "@atlas/cli",
  "version": "0.3.27",
  "type": "module",
  "description": "Interactive Atlas project generation, development, and static publication tooling.",
  "license": "MIT",
  "keywords": [
    "app",
    "cli",
    "native-federation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bendaj11/atlas.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/bendaj11/atlas/tree/main/packages/cli#readme",
  "bugs": "https://github.com/bendaj11/atlas/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "atlas": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-output.js && tsc -b",
    "test": "node dist/index.js compile-config catalog-react && pnpm --filter @atlas-app/catalog-react run build && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.json --testPathPattern=packages/cli/tests/ --testTimeout=15000",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@atlas/bootstrap": "0.3.27",
    "@atlas/schema": "0.3.27",
    "@atlas/generators": "0.3.27",
    "@atlas/runtime": "0.3.27",
    "@aws-sdk/client-s3": "^3.850.0",
    "@inquirer/select": "^4.4.2",
    "cross-spawn": "7.0.6",
    "typescript": "~5.9.0"
  }
}
