{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@atlas/bootstrap": ["../bootstrap/src/index.ts"],
      "@atlas/schema": ["../schema/src/index.ts"],
      "@atlas/generators": ["../generators/src/index.ts"],
      "@atlas/runtime": ["../runtime/dist/index.d.ts"],
      "@atlas/sdk": ["../sdk/dist/index.d.ts"],
      "@atlas/sdk/*": ["../sdk/dist/*.d.ts"]
    },
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "references": [
    { "path": "../bootstrap" },
    { "path": "../schema" },
    { "path": "../generators" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.specs.ts", "src/**/*.driver.ts", "src/**/*.testkit.ts"]
}
