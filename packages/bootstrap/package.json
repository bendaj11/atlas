{
  "name": "@atlas/bootstrap",
  "version": "0.3.28",
  "type": "module",
  "description": "Static Atlas browser bootstrap assets and Nginx configuration.",
  "license": "MIT",
  "keywords": [
    "atlas",
    "host",
    "static",
    "nginx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bendaj11/atlas.git",
    "directory": "packages/bootstrap"
  },
  "homepage": "https://github.com/bendaj11/atlas/tree/main/packages/bootstrap#readme",
  "bugs": "https://github.com/bendaj11/atlas/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-output.js && tsc -b",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.json --testPathPattern=packages/bootstrap/tests/",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@atlas/schema": "0.3.28",
    "es-module-shims": "^2.7.0"
  }
}
