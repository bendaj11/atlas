{
  "name": "@atlas/bootstrap",
  "version": "0.4.11",
  "type": "module",
  "description": "Static Atlas browser bootstrap assets and Nginx configuration.",
  "license": "MIT",
  "keywords": [
    "atlas",
    "host",
    "static",
    "nginx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bendaj11/atlas.git",
    "directory": "packages/bootstrap"
  },
  "homepage": "https://github.com/bendaj11/atlas/tree/main/packages/bootstrap#readme",
  "bugs": "https://github.com/bendaj11/atlas/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "tsx ../../scripts/clean-package-output.ts && tsc -b && esbuild src/atlas-loader/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/atlas.loader.js",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.json --testPathPattern=packages/bootstrap/src/",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@atlas/schema": "0.4.11",
    "es-module-shims": "^2.7.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "esbuild": "0.25.12"
  }
}
