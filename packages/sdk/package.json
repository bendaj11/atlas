{
  "name": "@atlas/sdk",
  "version": "0.3.59",
  "type": "module",
  "description": "Atlas app-to-host communication SDK and framework adapters.",
  "license": "MIT",
  "keywords": [
    "app",
    "sdk",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bendaj11/atlas.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/bendaj11/atlas/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/bendaj11/atlas/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "default": "./dist/lifecycle.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "default": "./dist/navigation.js"
    },
    "./federation": {
      "types": "./dist/federation.d.ts",
      "default": "./dist/federation.js"
    },
    "./federation-config": {
      "types": "./federation-config.d.cts",
      "import": "./federation-config.mjs",
      "require": "./federation-config.cjs"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "default": "./dist/angular.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "federation-config.cjs",
    "federation-config.d.cts",
    "federation-config.mjs"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "tsx ../../scripts/clean-package-output.ts && ngc -p tsconfig.angular.json && tsc -p tsconfig.federation-config.json",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.json --testPathPattern='packages/sdk/(src|tests)/'",
    "typecheck": "ngc -p tsconfig.angular.json --noEmit"
  },
  "dependencies": {
    "@atlas/schema": "0.3.59",
    "@softarc/native-federation-runtime": "^3.5.5",
    "cjs-module-lexer": "^1.4.3"
  },
  "peerDependencies": {
    "@angular/core": ">=19 <23",
    "@angular/platform-browser": ">=19 <23",
    "react": ">=17 <20",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/platform-browser": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/compiler": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "vite": "^7.3.6"
  }
}
