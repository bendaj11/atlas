{
  "name": "@atlas/sdk",
  "version": "0.5.1",
  "type": "module",
  "description": "Atlas app-to-host communication SDK and framework adapters.",
  "license": "MIT",
  "keywords": [
    "app",
    "sdk",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bendaj11/atlas.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/bendaj11/atlas/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/bendaj11/atlas/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "default": "./dist/lifecycle.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "default": "./dist/navigation.js"
    },
    "./federation": {
      "types": "./dist/federation.d.ts",
      "default": "./dist/federation.js"
    },
    "./federation-config": {
      "import": {
        "types": "./dist/federation-config.d.mts",
        "default": "./dist/federation-config.mjs"
      },
      "require": {
        "types": "./dist/federation-config.d.cts",
        "default": "./dist/federation-config.cjs"
      }
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "default": "./dist/angular.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.cts",
    "dist/**/*.mjs",
    "dist/**/*.d.mts"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsx ../../scripts/clean-package-output.ts && ngc -p tsconfig.angular.json",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.json --testPathPattern='packages/sdk/src/' --testTimeout=30000",
    "test:e2e": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.json --testPathPattern='packages/sdk/e2e/' --testTimeout=60000",
    "typecheck": "ngc -p tsconfig.angular.json --noEmit"
  },
  "dependencies": {
    "@atlas/schema": "workspace:^",
    "@softarc/native-federation-runtime": "^3.5.5",
    "cjs-module-lexer": "^1.4.3"
  },
  "peerDependencies": {
    "@angular/common": ">=19 <23",
    "@angular/core": ">=19 <23",
    "@angular/platform-browser": ">=19 <23",
    "react": ">=17 <20",
    "typescript": ">=5.5",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/platform-browser": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react-dom": "^19.2.0",
    "jest-environment-jsdom": "29.7.0",
    "react-dom": "^19.2.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@faker-js/faker": "^10.5.0",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "vite": "^7.3.6"
  }
}
