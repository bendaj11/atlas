{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": { "@atlas/schema": ["../schema/src/index.ts"] },
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "references": [{ "path": "../schema" }],
  "include": ["src/**/*.ts", "src/**/*.cts", "src/**/*.mts"],
  "exclude": [
    "src/**/*.specs.ts",
    "src/**/*.specs.tsx",
    "src/**/*.driver.ts",
    "src/**/*.driver.tsx",
    "src/**/*.testkit.ts"
  ]
}
